# GitHub OAuth App credentials.
# Create one at https://github.com/settings/developers
#   Homepage URL:             http://localhost:3000
#   Authorization callback:   http://localhost:3000/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Random 64-char hex string: openssl rand -hex 32
SESSION_SECRET=

# Optional overrides
REPO_OWNER=is-a-dev
REPO_NAME=register
# OAUTH_REDIRECT_URL=http://localhost:3000/api/auth/callback

# Dev-only: skip OAuth and sign in with a PAT (e.g. `gh auth token`). Never enable in production.
# ALLOW_DEV_TOKEN=1
# GITHUB_TOKEN=
